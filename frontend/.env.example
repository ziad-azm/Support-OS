# Copy to frontend/.env and adjust if your backend runs elsewhere.
# Vite only exposes variables prefixed with VITE_ to client code.
VITE_API_BASE_URL=http://localhost:8000/api

# --- Error monitoring (PROD-1) ---
# Leave blank to disable browser error monitoring (the local default).
# A Sentry DSN is not a secret, but everything VITE_-prefixed is bundled into
# the JavaScript shipped to the browser — never put a real secret here.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=local
